<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 3D 7.0.0" snapToGrid="false">
  <code><![CDATA[breed [swarm-agents swarm-agent]
breed [midpoints midpoint]
breed [cogs cog]



globals [
  curr-midpoint; the index of the currently selected midpoint
  vel-history  ;; keeps recent velocity magnitudes
  window-size  ;; size of sliding window
]


swarm-agents-own [
  swarm ;index of the swarm this agent belongs to
]

midpoints-own [
  index ;index of the midpoint (for swarm behaviour)
  orientation
]

;Setup-----------------------------------------------------------------------


to startup
  setup
end

to setup
  clear-all
  setup-agents
  setup-world
  setup-midpoints
  select-midpoint
  if (set-mode = "multiple-set") [
    setup-multiple-set
  ]
  setup-cogs
  set vel-history []
  set window-size 10  ;; e.g., average over last 10 ticks
  reset-ticks
end

to setup-world
 ask patches with [pzcor = min-pzcor][
   set pcolor white
  ]
  ask patches with [pzcor = min-pzcor] [
    if (pycor = min-pycor) and (pxcor < -20) [set pcolor red]
    if (pxcor = min-pxcor) and (pycor < -20 ) [set pcolor green]
  ]
  ask patches with [pycor = min-pycor and pxcor = min-pxcor ] [
    if (pzcor < -20) [set pcolor blue]
  ]
end


to setup-cogs
  create-cogs 1
  ask cogs [
    set shape "circle"
    set size 2
  ]

  ask one-of cogs [
    set color black
  ]
end

to setup-agents
  create-swarm-agents agent-count
  ask swarm-agents [
    initialize-agent
  ]
end

to setup-midpoints
  create-midpoints midpoints-count
  ask midpoints [
    initialize-midpoints
  ]
  let i 1
  while [i <= midpoints-count]
  [
    ask one-of midpoints with [index = 0] [
       set index i
    ]
    set i i + 1
  ]

end

to setup-multiple-set
  let set-size agent-count / midpoints-count
  let i 1
  while [i <= midpoints-count] [
    ask n-of set-size swarm-agents with [swarm = 0] [
      set swarm i
    ]
    set i i + 1
  ]

  ;the remaning agents if agent-count mod midpoints-count != 0
  ask swarm-agents with [swarm = 0] [
    set swarm 1
  ]



  ask swarm-agents [
    set color ((swarm * 10) + 5)
  ]
  ask midpoints [
    set color ((index * 10) + 5)
  ]
end

;Init

to initialize-agent
   set swarm 0
   setxyz  random-xcor random-ycor random-zcor
   set color orange
end



to initialize-midpoints
  set index 0
  setxyz (round random-xcor) (round random-ycor) 0
  set color red
  set shape "x"
  set size 1
  set pitch 90
  set orientation (list dx dy dz)
end







to midpoint-formation-flower

  if (midpoints-count < 5) [
    user-message ("You need 5 mipoints for this Formation. Please change midpoints-count to 5 and press setup again before trying again.")
  ]


  ask midpoints with [index = 1] [
    set xcor 0
    set ycor 0
    set zcor 0
  ]
  ask midpoints with [index = 2] [
    set xcor 5
    set ycor 0
    set zcor 0
  ]

  ask midpoints with [index = 3] [
    set xcor -5
    set ycor 0
    set zcor 0
  ]

  ask midpoints with [index = 4] [
    set xcor 0
    set ycor -5
    set zcor 0
  ]

  ask midpoints with [index = 5] [
    set xcor 0
    set ycor 5
    set zcor 0
  ]

  set curr-midpoint 0
  ask midpoints [
    set shape "x"
  ]




end

to midpoint-formation-A
  if (midpoints-count < 3) [
    user-message ("You need 3 mipoints for this Formation. Please change midpoints-count to 3 and press setup again before trying again.")
  ]
  ask midpoints with [index = 1] [
    set xcor 0
    set ycor 0
    set zcor 0
    set heading 90
    set pitch 0
    set orientation (list dx dy dz)

  ]
  ask midpoints with [index = 2] [
    set xcor 5
    set ycor 0
    set zcor 0
    set heading 200
    set pitch 0
    set orientation (list dx dy dz)
  ]

  ask midpoints with [index = 3] [
    set xcor -5
    set ycor 0
    set zcor 0
    set heading 160
    set pitch 0
    set orientation (list dx dy dz)
  ]

  set curr-midpoint 0
  ask midpoints [
    set shape "x"
  ]

end

to midpoint-formation-V
  if (midpoints-count < 2) [
    user-message ("You need 2 mipoints for this Formation. Please change midpoints-count to 2 and press setup again before trying again.")
  ]
  ask midpoints with [index = 1] [
    set xcor 2
    set ycor 0
    set zcor 0
    set heading 200
    set pitch 0
    set orientation (list dx dy dz)
  ]

  ask midpoints with [index = 2] [
    set xcor -2
    set ycor 0
    set zcor 0
    set heading 160
    set pitch 0
    set orientation (list dx dy dz)
  ]

  set curr-midpoint 0
  ask midpoints [
    set shape "x"
  ]

end



to midpoint-formation-olympic

  if (midpoints-count < 5) [
    user-message ("You need 5 mipoints for this Formation. Please change midpoints-count to 5 and press setup again before trying again.")
  ]


  ask midpoints with [index = 1] [
    set xcor 0
    set ycor 0
    set zcor 0
  ]
  ask midpoints with [index = 2] [
    set xcor 15
    set ycor 0
    set zcor 0
  ]

  ask midpoints with [index = 3] [
    set xcor -15
    set ycor 0
    set zcor 0
  ]

  ask midpoints with [index = 4] [
    set xcor 7
    set ycor -10
    set zcor 0
  ]

  ask midpoints with [index = 5] [
    set xcor -7
    set ycor -10
    set zcor 0
  ]

  set curr-midpoint 0
  ask midpoints [
    set shape "x"
  ]

end



;;GO--------------------------------------------------------------------------------------;;

to go

  ;Set the position of the selected Midpoint
  ;go-midpoints
  let mid-agent nobody
  ask swarm-agents [
    if-else (set-mode = "multiple-set") [
      set mid-agent one-of midpoints with [index = [swarm] of myself]
    ] [
      set mid-agent min-one-of midpoints [distance myself]
    ]

    let vector [0 0 0]

    (ifelse
      swarm-algorithm = "Ring-of-Fliers" [
        set vector calc-ring-of-fliers mid-agent
      ]
      swarm-algorithm = "Ball-of-Fliers" [
        set vector calc-ball-of-fliers mid-agent
      ]
      swarm-algorithm = "Line-of-Fliers" [
        set vector calc-line-of-fliers mid-agent
      ]
    )


    adapt-flight-vector vector

  ]

  plot-variance-distance-to-closest-neighbor
  plot-cog-vel
  
  if-else (set-mode = "multiple-set") [
      plot-average-distance-to-own-midpoint
    ] [
      plot-average-distance-to-closest-midpoint 
    ]
  tick
end


to experiment
  go
  if (ticks = 500) [
    add-n-agents 20
  ] 
  
  if (ticks = 1000) [
    remove-n-agents 20
  ]
 
  if (ticks = 1500) [
    ask midpoints [
      set xcor xcor + 3
      set ycor ycor + 3
    ]
  ]
  
  if (ticks = 2000) [
    build-wall
  ] 
  if (ticks = 2500) [
    stop
  ]
end


to conditional-experiment 
  let mid-agent nobody
  ask swarm-agents [
    
    set mid-agent min-one-of midpoints [distance myself]

    let vector [0 0 0]
    
    if [index] of mid-agent = 1 [
      set vector calc-ring-of-fliers mid-agent
    ]
    
    if [index] of mid-agent = 2 [
      set vector calc-line-of-fliers mid-agent
    ]
    adapt-flight-vector vector

  ]

  plot-variance-distance-to-closest-neighbor
  plot-cog-vel
  
  if-else (set-mode = "multiple-set") [
      plot-average-distance-to-own-midpoint
    ] [
      plot-average-distance-to-closest-midpoint 
    ]
  tick
  
end





to plot-average-distance-to-own-midpoint
  set-current-plot "Average Distance to Mid"
  set-current-plot-pen "distance"
  let distances [distance (one-of midpoints with [index = [swarm] of myself]) ] of swarm-agents
  plot standard-deviation distances
end

to plot-average-distance-to-closest-midpoint
  set-current-plot "Average Distance to Mid"
  set-current-plot-pen "distance"
  let distances [ distance (min-one-of midpoints [distance myself]) ] of swarm-agents
  plot standard-deviation distances
end


to plot-variance-distance-to-closest-neighbor
  let distances [
    ifelse-value any? other swarm-agents
      [distance (min-one-of other swarm-agents [distance myself])]
      [0]  ;; if no neighbors, fallback distance = 0
  ] of swarm-agents

  set-current-plot "standard-deviation Distance to Neighbour"
  set-current-plot-pen "distance"
  plot standard-deviation distances

end

to plot-distance-agent-cog-to-midpoint-cog
  let x-avg-swarm mean [xcor] of swarm-agents
  let y-avg-swarm mean [ycor] of swarm-agents
  let z-avg-swarm mean [zcor] of swarm-agents
  
  let cog-swarm (list x-avg-swarm y-avg-swarm z-avg-swarm)

  ask one-of cogs with [color = black] [
    set-current-plot "Cog-vel"
    set-current-plot-pen "distance"
    let dex (xcor - x-avg-swarm)
    let dey (ycor - y-avg-swarm)
    let dez (zcor - z-avg-swarm)
    plot magnitude (list dex dey dez)
    setxyz x-avg-swarm y-avg-swarm z-avg-swarm
  ]
  
end

to plot-cog-vel
  let x-avg-swarm mean [xcor] of swarm-agents
  let y-avg-swarm mean [ycor] of swarm-agents
  let z-avg-swarm mean [zcor] of swarm-agents
  
  ask one-of cogs with [color = black] [
    set-current-plot "Cog-vel"
    set-current-plot-pen "distance"
    let dex (xcor - x-avg-swarm)
    let dey (ycor - y-avg-swarm)
    let dez (zcor - z-avg-swarm)
    
    let inst-dist magnitude (list dex dey dez)

    ;; store in history
    set vel-history lput inst-dist vel-history
    if (length vel-history > window-size) [
      set vel-history but-first vel-history
    ]

    ;; sliding window average
    let avg-dist mean vel-history
    
    ;; plot smoothed velocity (not instantaneous)
    plot avg-dist
    
    ;; still move cog to midpoint
    setxyz x-avg-swarm y-avg-swarm z-avg-swarm
  ]
end






to go-midpoints
  ask midpoints with [index = curr-midpoint] [
    set xcor controller-x
    set ycor controller-y
    set zcor controller-z
    set heading controller-heading
    set pitch controller-pitch
    set orientation (list dx dy dz)
  ]
  ;tick
end





to-report calc-ring-of-fliers [mid-agent]
  let mid agent-to-vector mid-agent
  ;center urge
  let center-urge sub mid (agent-to-vector self)
  ;set center-urge scale (((magnitude center-urge) - radius) / (magnitude center-urge))  center-urge
  set center-urge scale (((magnitude center-urge) - radius))  center-urge

  ;seperation urge
  let separation-urge [0 0 0]
  let seperation-urge-weight 0
  let closest min-one-of other swarm-agents in-radius neighborhood-radius [distance myself]
  if (closest != nobody) [
    set separation-urge sub (agent-to-vector self) (agent-to-vector closest)
    set seperation-urge-weight ((1 / magnitude separation-urge) ^ 2)
  ]
  set separation-urge scale seperation-urge-weight separation-urge




  ;flat urge
  let flat-urge [orientation] of mid-agent
  let flat-urge-weight ((scalar-prod (sub mid (agent-to-vector self) ) flat-urge) / (magnitude flat-urge))
  set flat-urge scale (flat-urge-weight) flat-urge

  ;add urges
  let vector [0 0 0]
  set vector add vector center-urge
  set vector add vector separation-urge
  set vector add vector flat-urge

  ;avoid obstacle urge
  let obstacle-urge avoid-closest-obstacle-urge
  let obstacle-urge-weight 0
  if (magnitude obstacle-urge != 0) [
    set obstacle-urge-weight ((1 / magnitude obstacle-urge) ^ obstacle-urge-weight-modifer)
    ;set obstacle-urge-weight 1
  ]
  set obstacle-urge scale obstacle-urge-weight obstacle-urge
  set vector add vector obstacle-urge

  report vector

end


to-report avoid-obstacle-urge ;; turtle reporter
  let urge (list 0 0 0)
  ;; report the sum of the distances from
  ;; any patches that are obstacles
  ;; in each direction
  ask patches in-radius neighborhood-radius with [ pcolor != black ]
  [ set urge
      add
        urge
        sub
          (list [xcor] of myself [ycor] of myself [zcor] of myself)
          (list pxcor pycor pzcor)
  ]
  report urge
end

to-report avoid-closest-obstacle-urge ;; turtle reporter
  let urge (list 0 0 0)
  ;; report the sum of the distances from
  ;; any patches that are obstacles
  ;; in each direction
  let closest min-one-of patches in-radius neighborhood-radius with [ pcolor != black ] [distance myself]
  if closest != nobody [
    ask closest [
      set urge
      add
      urge
      sub
      (list [xcor] of myself [ycor] of myself [zcor] of myself)
      (list pxcor pycor pzcor)
    ]
    report urge
  ]
  report urge
end


to-report calc-ball-of-fliers [mid-agent]
  let mid agent-to-vector mid-agent
  ;center urge
  let center-urge sub mid (agent-to-vector self)
  set center-urge scale (((magnitude center-urge) - ( radius )) / (magnitude center-urge))  center-urge

  ;seperation urge
  let separation-urge [0 0 0]
  let seperation-urge-weight 0
  let closest min-one-of other swarm-agents in-radius neighborhood-radius [distance myself]
  if (closest != nobody) [
    set separation-urge sub (agent-to-vector self) (agent-to-vector closest)
    set seperation-urge-weight ((1 / magnitude separation-urge) ^ 2)
  ]
  set separation-urge scale seperation-urge-weight separation-urge

  ;add urges
  let vector [0 0 0]
  set vector add vector center-urge
  set vector add vector separation-urge
  
  
  ;avoid obstacle urge
  let obstacle-urge avoid-closest-obstacle-urge
  let obstacle-urge-weight 0
  if (magnitude obstacle-urge != 0) [
    set obstacle-urge-weight ((1 / magnitude obstacle-urge) ^ obstacle-urge-weight-modifer)
    ;set obstacle-urge-weight 1
  ]
  set obstacle-urge scale obstacle-urge-weight obstacle-urge
  set vector add vector obstacle-urge
  
  
  report vector

end

to-report calc-line-of-fliers [mid-agent]
  ;Projection onto line
  let mid agent-to-vector mid-agent
  let direction [orientation] of mid-agent
  let agent agent-to-vector self
  let projection line-projection agent mid direction
  let line-urge sub projection agent
  set line-urge scale 27 line-urge


  ;center urge
  let center-urge sub mid agent
  let weight magnitude sub agent mid - radius
  let center-urge-weight ifelse-value (weight > 0) [weight][0]
  set center-urge scale center-urge-weight center-urge


  ;seperation urge
  let closest min-one-of other swarm-agents in-radius neighborhood-radius [distance myself]
  let separation-urge [0 0 0]
  let seperation-urge-weight 0
  if (closest != nobody) [
    set separation-urge sub (agent-to-vector self) (agent-to-vector closest)
    set seperation-urge-weight ((1 / magnitude separation-urge) ^ 2)
  ]
  set separation-urge scale seperation-urge-weight separation-urge

  ;add urges
  let vector [0 0 0]
  set vector add vector line-urge
  set vector add vector separation-urge
  set vector add vector center-urge
  
  ;avoid obstacle urge
  let obstacle-urge avoid-closest-obstacle-urge
  let obstacle-urge-weight 0
  if (magnitude obstacle-urge != 0) [
    set obstacle-urge-weight ((1 / magnitude obstacle-urge) ^ obstacle-urge-weight-modifer)
    ;set obstacle-urge-weight 1
  ]
  set obstacle-urge scale obstacle-urge-weight obstacle-urge
  set vector add vector obstacle-urge

  report vector
end

to-report line-projection [point origin direction]
  let a scalar-prod sub point origin direction
  let b scalar-prod direction direction
  report add scale (a / b) direction origin
end








to adapt-flight-vector [vector]
  if (magnitude vector > max-velocity) [
    set vector (scale max-velocity normalize vector)
  ]
  let nxcor xcor + (item 0 vector)
  let nycor ycor + (item 1 vector)
  let nzcor zcor + (item 2 vector)
  facexyz nxcor nycor nzcor
  fd magnitude vector
end


to remove-agent
  ask one-of swarm-agents [
    die
  ]
end

to remove-n-agents [n]
  ask n-of n swarm-agents [
    die
  ]
end

to add-agent
  create-swarm-agents 1 [
    initialize-agent
    if (set-mode = "multiple-set") [
      set swarm [swarm] of min-one-of other swarm-agents [distance myself]
      ask swarm-agents [
        set color ((swarm * 10) + 5)
      ]
    ]

  ]

end

to add-n-agents [n]
    create-swarm-agents n [
    initialize-agent
    if (set-mode = "multiple-set") [
      set swarm [swarm] of min-one-of other swarm-agents [distance myself]
      ask swarm-agents [
        set color ((swarm * 10) + 5)
      ]
    ]

  ]
end



;;--------------------------------------- gui functions --------------------------------------------


to select-midpoint
  set curr-midpoint selected-midpoint
  ask midpoints with [index = selected-midpoint] [
     set controller-x xcor
     set controller-y ycor
     set controller-z zcor
     set controller-heading heading
     set controller-pitch pitch
     set shape "arrow"
  ]

  ask midpoints with [index != selected-midpoint] [
    set shape "x"
  ]
end


to hide-midpoints
  ask midpoints [
    if-else (hidden?) [
      st
    ] [
      ht
    ]
  ]
end

;; --------------------------------------- vector functions ----------------------------------------


to-report agent-to-vector [agent]
  report (list [xcor] of agent [ycor] of agent [zcor] of agent)
end

to-report patch-to-vector [p]
  report (list [pxcor] of p [pycor] of p [pzcor] of p)
end



to-report add [v1 v2]
  report (map + v1 v2)
end

to-report sub [v1 v2]
  report (map - v1 v2)
end

to-report scale [scalar vector]
  report map [n -> scalar * n] vector
end

to-report magnitude [vector]
  report sqrt sum map [n -> n * n] vector
end

to-report normalize [vector]
  let m magnitude vector
  if m = 0 [
    report vector
  ]
  report map [n -> n / m] vector
end

to-report scalar-prod [v1 v2]
  report sum (map * v1 v2)
end

to-report cross-prod [v1 v2]
  let r1 (item 1 v1)*(item 2 v2) - (item 2 v1) * (item 1 v2)
  let r2 (item 2 v1)*(item 0 v2) - (item 0 v1) * (item 2 v2)
  let r3 (item 0 v1)*(item 1 v2) - (item 1 v1) * (item 0 v2)

  report (list (r1) (r2) (r3))
end


;; --------------------------------------- world functions ----------------------------------------

to build-random-wall
  let x max-pxcor - random world-width
  let ydir 1 - random 2
  if ydir = 0 [ set ydir -1 ]
  let height random max-pxcor
  ask patches
    with [ pxcor = x and ydir * pycor < 0 and pzcor < height ]
    [ set pcolor gray + random 2 ]
end

to build-wall
  let x 0
  let height (0.7 * max-pxcor)
  ask patches
    with [ pxcor = x and pzcor < height ]
    [ set pcolor gray + random 2 ]
end

to build-half-wall
  let x 0
  let height (0.7 * max-pxcor)
  ask patches
    with [ pxcor = x and pycor < 0 and pzcor < height ]
    [ set pcolor gray + random 2 ]
end










