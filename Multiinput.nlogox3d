    <chooser x="115" y="107" height="60" variable="set-mode" current="0" width="148" display="set-mode">
      <choice type="string" value="singe-set"></choice>
      <choice type="string" value="multiple-set"></choice>
    </chooser>
    <note x="115" y="41" backgroundDark="0" fontSize="12" width="660" markdown="false" height="47" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">----------------------------------------------------------------------------------------------------
