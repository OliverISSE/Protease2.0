    <slider x="125" step="1" y="871" max="100" width="173" display="radius" height="50" min="0" direction="Horizontal" default="9.0" variable="radius"></slider>
    <button x="118" y="271" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="126">go-midpoints</button>
    <slider x="408" step="1" y="454" max="360" width="190" display="controller-heading" height="50" min="0" direction="Horizontal" default="201.0" variable="controller-heading"></slider>
